---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Sahifa topilmadi — Akbarov Labs" current="other">
  <section class="nf">
    <span class="mono">[404] TOPILMADI</span>
    <h1 class="huge">yoʻq.</h1>
    <p>Bu sahifa koʻchirilgan yoki hech qachon boʻlmagan.</p>
    <div class="row">
      <a href="/" class="btn btn-ink">Bosh sahifa</a>
      <a href="/blog/" class="btn btn-outline">Blog</a>
    </div>
  </section>
  <Footer slot="footer" />
</Base>

<style>
  .nf {
    padding: 48px var(--gutter) 80px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  p {
    margin: 0;
    font-size: 20px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
