---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Girih from '../components/Girih.astro';
import Assistant from '../components/Assistant.astro';
import PostCard from '../components/PostCard.astro';
import Featured from '../components/Featured.astro';
import kitoblarim from '../assets/kitoblarim.png';
import olgo from '../assets/works/olgo.png';
import alifbo from '../assets/works/alifbo.png';
import aktivYodla from '../assets/works/aktiv-yodla.png';
import posbon from '../assets/works/posbon.png';
import birgaolamizmi from '../assets/works/birgaolamizmi.png';
import { site, plans, contactHref, contactLabel } from '../data/site';
import { services } from '../data/services';
import { featuredWork, works } from '../data/works';
import { getPosts } from '../data/blog';

const posts = (await getPosts()).slice(0, 3);

// Logos for src/data/works.ts, by id (that file stays import-free for the assistant).
const logos = { olgo, alifbo, 'aktiv-yodla': aktivYodla, posbon, birgaolamizmi };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  description: site.description,
  founder: { '@type': 'Person', name: site.founder },
  areaServed: 'UZ',
  sameAs: [site.instagram && `https://instagram.com/${site.instagram}`, site.telegram && `https://t.me/${site.telegram}`].filter(Boolean),
};
---
<Base title="Akbarov Labs — saytlar, Telegram botlar va AI" jsonLd={jsonLd}>
  <!-- Hero: headline and the assistant's sample chat -->
  <section class="wrap hero">
    <div class="hero-text">
      <p class="label">IT va AI ustaxonasi · Oʻzbekiston</p>
      <h1>Raqamli ustaxona.</h1>
      <p class="lead">
        Usta kabi ishlaymiz: saytlar, Telegram botlar va biznes tizimlarini oʻlchab, puxta quramiz — va ularga sunʼiy
        intellektni ulab beramiz.
      </p>
      <div class="row">
        <a href="#aloqa" class="btn btn-primary">Loyihani muhokama qilish</a>
        <a href="#ishlar" class="btn btn-outline">Ishlarimiz</a>
      </div>
      <p class="hint"><span class="dot" aria-hidden="true"></span>Shu sahifadagi yordamchi — bizning birinchi AI mahsulotimiz.</p>
    </div>
    <div class="hero-panel">
      <Girih id="g-hero" opacity={0.9} />
      <Assistant />
    </div>
  </section>

  <!-- Services -->
  <section id="xizmatlar" class="services-band" aria-labelledby="xizmatlar-title">
    <h2 id="xizmatlar-title" class="sr-only">Xizmatlar</h2>
    <div class="wrap services">
      {services.map((s) => (
        <div class="service">
          <div class:list={['icon', { 'icon-accent': s.accent }]}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
          </div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Work -->
  <section id="ishlar" class="wrap section">
    <div class="section-head">
      <div>
        <p class="label">Ishga tushirilganlar</p>
        <h2>Ustaxonadan chiqqan ishlar</h2>
      </div>
    </div>
    <article class="work">
      <div class="work-pic">
        <Image src={kitoblarim} alt="Kitoblarim logotipi: “Har bir kitob oʻz javonida.”" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 640px" />
      </div>
      <div class="work-text">
        <p class="meta"><span class="live" aria-hidden="true"></span>Ishlamoqda · {featuredWork.kind}</p>
        <h3>{featuredWork.name}</h3>
        <p>{featuredWork.text}</p>
        <ul>
          {featuredWork.features.map((f) => <li>{f}</li>)}
        </ul>
        <div class="ext-row">
          {featuredWork.links.map((l) => <a href={l.href} class="ext" rel="noopener">{l.text} →</a>)}
        </div>
      </div>
    </article>

    <ul class="works" role="list">
      {works.map((w) => (
        <li>
          <a href={w.href} class="w-card" rel="noopener">
            <Image src={logos[w.id as keyof typeof logos]} alt="" width={56} height={56} densities={[1, 2]} class="w-logo" />
            <p class="meta"><span class="live" aria-hidden="true"></span>Ishlamoqda · {w.kind}</p>
            <h3>{w.name}</h3>
            <p class="w-text">{w.text}</p>
            <span class="w-link">{w.linkText} →</span>
          </a>
        </li>
      ))}
      <li>
        <a href="#aloqa" class="next">
          <span class="next-text">Keyingi ish — sizning loyihangiz.</span>
          <span class="next-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </section>

  <!-- AI -->
  <section class="ai">
    <Girih id="g-ai" tile={120} star="var(--white)" hole="var(--lapis)" dot="var(--white)" opacity={0.09} />
    <div class="wrap ai-inner">
      <div class="ai-text">
        <p class="label">Sunʼiy intellekt</p>
        <h2 class="h2">AI bilan tezroq ishlaymiz — va sizga ham oʻrnatib beramiz</h2>
        <p>
          Har bir loyihada Claude kabi zamonaviy AI vositalaridan foydalanamiz: kod tezroq yoziladi, koʻproq tekshiriladi va
          siz natijani ertaroq koʻrasiz.
        </p>
      </div>
      <ul class="ai-list">
        <li>Mijozlarga kecha-kunduz javob beradigan Telegram yordamchi</li>
        <li>Ariza va hujjatlarni avtomatik saralash</li>
        <li>Sotuv va hisobotlar boʻyicha oddiy tilda savol-javob</li>
      </ul>
    </div>
  </section>

  <!-- Founder -->
  <section class="wrap section founder">
    <div class="founder-pic">
      {site.founderPhoto ? (
        <img src={site.founderPhoto} alt={site.founder} loading="lazy" />
      ) : (
        <>
          <Girih id="g-founder" tile={80} star="var(--lapis)" hole="var(--mist)" dot="var(--saffron)" opacity={0.25} />
          <span class="founder-mark"><Mark size={150} /></span>
        </>
      )}
    </div>
    <div class="founder-text">
      <p class="label">Kim quradi</p>
      <blockquote>“Siz menejer bilan emas, kodni yozadigan odam bilan gaplashasiz.”</blockquote>
      <p>Har bir loyihani oʻzim boshqaraman. Natijani har hafta koʻrsatib boraman.</p>
      <p class="sign">{site.founder} — asoschi</p>
    </div>
  </section>

  <!-- Prices -->
  <section id="narxlar" class="prices-band">
    <div class="wrap section">
      <div class="section-head">
        <div>
          <p class="label">Narxlar</p>
          <h2>Boshlangʻich narxlar</h2>
        </div>
      </div>
      <div class="plans">
        {plans.map((p) => (
          <div class:list={['plan', { 'plan-dark': p.featured }]}>
            <div class="plan-head">
              <h3>{p.name}</h3>
              {p.featured && <span class="badge">Ommabop</span>}
            </div>
            {p.price ? (
              <p class="price">{p.price} <span>soʻmdan</span></p>
            ) : (
              <p class="price price-ask">Narxi suhbatda aniqlanadi</p>
            )}
            <ul>
              {p.items.map((i) => <li>{i}</li>)}
            </ul>
            {p.term && <p class="term">Muddat: {p.term}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog -->
  {posts.length > 0 && (
    <section id="blog" class="wrap section">
      <div class="section-head">
        <div>
          <p class="label">Blog</p>
          <h2>Blogdan</h2>
        </div>
        <a href="/blog/" class="all">Barcha maqolalar →</a>
      </div>
      {posts.length === 1 ? (
        <Featured post={posts[0]} label="Yangi" />
      ) : (
        <div class="blog-grid">{posts.map((p) => <PostCard post={p} />)}</div>
      )}
    </section>
  )}

  <!-- Contact -->
  <section id="aloqa" class="contact dark">
    <div class="wrap contact-inner">
      <div class="contact-text">
        <p class="label">Aloqa</p>
        <h2>Yozing.</h2>
        <p>Vazifani birga koʻrib chiqamiz va narxini aytamiz.</p>
        <div class="contact-links">
          <a href={contactHref} class="btn btn-saffron">{contactLabel}</a>
          {site.telegram && <a href={`mailto:${site.email}`}>{site.email}</a>}
          {site.instagram && <a href={`https://instagram.com/${site.instagram}`} rel="noopener">@{site.instagram}</a>}
        </div>
      </div>
      <div class="contact-tile" aria-hidden="true">
        <Girih id="g-contact" tile={110} hole="var(--ink)" dot="var(--lapis)" opacity={0.9} />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 56px;
    align-items: stretch;
    padding-block: 48px 80px;
  }
  .hero-text {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(48px, 6.2vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .lead {
    margin: 0;
    font-size: 21px;
    line-height: 1.55;
    color: var(--body);
    max-width: 580px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hint {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: var(--body);
  }
  .dot {
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 50%;
    background: var(--saffron);
  }
  .hero-panel {
    position: relative;
    flex: 1 1 520px;
    min-width: 0;
    max-width: 640px;
    border-radius: 28px;
    background: var(--lapis);
    overflow: hidden;
    padding: 48px 40px;
    display: flex;
    align-items: center;
  }

  .services-band {
    border-block: 1px solid var(--line);
  }
  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .service {
    padding: 36px 28px 44px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-left: 1px solid var(--line);
  }
  .service:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--mist);
    color: var(--lapis);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .icon-accent {
    background: var(--saffron);
    color: var(--ink);
  }
  .service h3 {
    margin: 4px 0 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: 20px;
  }
  .service p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--body);
  }

  .work {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 56px;
    align-items: center;
  }
  .work-pic {
    flex: 1 1 480px;
    min-width: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: #161c19;
  }
  .work-pic :global(img) {
    width: 100%;
    height: auto;
  }
  .work-text {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .meta {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .live {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #1f9d55;
  }
  .work-text h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(36px, 4vw, 52px);
    letter-spacing: -0.01em;
  }
  .work-text p:not(.meta) {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--body);
  }
  .work-text ul {
    margin: 0;
    padding-left: 20px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--body);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .work-text li::marker {
    color: var(--saffron);
  }
  .ext-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
  }
  .ext {
    font-weight: 600;
    padding: 8px 0;
  }

  .works {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  .w-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .w-card:hover {
    border-color: var(--lapis);
    color: var(--ink);
  }
  .w-logo {
    width: 56px;
    height: 56px;
    margin-bottom: 4px;
    border-radius: 16px;
    /* Olgo's logo sits on white; the hairline keeps it from melting into the card. */
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }
  .w-card h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: 22px;
  }
  .w-text {
    flex: 1;
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--body);
  }
  .w-link {
    font-weight: 600;
    color: var(--lapis);
    overflow-wrap: anywhere;
  }
  /* The last cell of the works grid, so five products plus this make full rows. */
  .next {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 28px;
    border-radius: var(--radius);
    border: 2px dashed var(--line-strong);
    color: var(--ink);
    text-decoration: none;
  }
  .next:hover {
    border-color: var(--lapis);
    color: var(--lapis);
  }
  .next-text {
    font-family: var(--display);
    font-weight: 500;
    font-size: 22px;
  }
  .next-arrow {
    align-self: flex-end;
    font-size: 28px;
    transition: transform 0.15s ease;
  }
  .next:hover .next-arrow {
    transform: translateX(4px);
  }

  .ai {
    position: relative;
    overflow: hidden;
    background: var(--lapis);
    color: var(--white);
  }
  .ai .label {
    color: var(--saffron);
  }
  .ai-inner {
    position: relative;
    padding-block: 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }
  .ai-text {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .ai-text p:not(.label) {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--on-dark);
  }
  .ai-list {
    flex: 1 1 380px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ai-list li {
    background: var(--white);
    color: var(--ink);
    border-radius: 16px;
    padding: 20px 22px 20px 56px;
    font-size: 17px;
    line-height: 1.45;
    position: relative;
  }
  .ai-list li::before {
    content: '';
    position: absolute;
    left: 22px;
    top: 24px;
    width: 14px;
    height: 14px;
    background: var(--saffron);
    transform: rotate(45deg);
    border-radius: 2px;
  }

  .founder {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: stretch;
  }
  .founder-pic {
    position: relative;
    flex: 1 1 340px;
    min-width: 0;
    min-height: 420px;
    border-radius: var(--radius);
    background: var(--mist);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .founder-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founder-mark {
    position: relative;
    width: 220px;
    height: 220px;
    border-radius: 40px;
    background: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .founder-text {
    flex: 2 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
  }
  blockquote {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .founder-text p:not(.label) {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--body);
  }
  .founder-text .sign {
    color: var(--ink);
    font-weight: 600;
  }

  .prices-band {
    background: var(--mist);
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .plan {
    background: var(--white);
    border-radius: var(--radius);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .plan-dark {
    background: var(--ink);
    color: var(--white);
  }
  .plan-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .plan h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: 20px;
  }
  .badge {
    background: var(--saffron);
    color: var(--ink);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .price {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 30px;
  }
  .price span {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 500;
    color: var(--muted);
  }
  .price-ask {
    font-size: 22px;
    line-height: 1.25;
  }
  .plan ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    color: var(--body);
  }
  .plan li {
    padding-left: 22px;
    position: relative;
  }
  .plan li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 7px;
    width: 8px;
    height: 8px;
    background: var(--lapis);
    transform: rotate(45deg);
  }
  .plan-dark ul {
    color: var(--on-dark);
  }
  .plan-dark li::before {
    background: var(--saffron);
  }
  .plan-dark .price span,
  .plan-dark .term {
    color: var(--on-dark);
  }
  .term {
    margin: auto 0 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .all {
    font-weight: 600;
    padding: 12px 0;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px 32px;
  }

  .contact-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: stretch;
    padding-block: 96px;
  }
  .contact-text {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .contact h2 {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(64px, 10vw, 140px);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }
  .contact-text p:not(.label) {
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--on-dark);
    max-width: 520px;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    align-items: center;
    font-size: 18px;
  }
  .contact-links a:not(.btn) {
    padding: 12px 0;
  }
  .contact-tile {
    position: relative;
    flex: 0 1 360px;
    min-height: 280px;
    border-radius: var(--radius);
    background: var(--lapis);
    overflow: hidden;
  }

  @media (max-width: 760px) {
    .hero {
      padding-block: 28px 48px;
    }
    h1 {
      letter-spacing: -0.01em;
    }
    .lead {
      font-size: 18px;
    }
    .hero-panel {
      padding: 24px 14px;
      border-radius: 22px;
    }
    .service {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding: 28px 0;
    }
    .service:first-child {
      border-top: 0;
    }
    .ai-inner,
    .contact-inner {
      padding-block: 64px;
    }
    .founder-pic {
      min-height: 280px;
    }
    .plan {
      padding: 24px;
    }
    .contact-tile {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .next-arrow,
    .w-card {
      transition: none;
