---
import Base from '../../layouts/Base.astro';
import Girih from '../../components/Girih.astro';
import PostCard from '../../components/PostCard.astro';
import Featured from '../../components/Featured.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getPosts, topics } from '../../data/blog';

const posts = await getPosts();
const [latest, ...rest] = posts;
// Topic chips only help once there are posts in more than one topic.
const used = topics.filter((t) => posts.some((p) => p.data.topic === t.id));
const showChips = used.length > 1;
---
<Base
  title="Blog — Akbarov Labs"
  description="Saytlar, Telegram botlar va AI haqida — oddiy tilda, biznes egalari uchun."
  current="blog"
>
  <section class="intro">
    <Girih id="g-blog" tile={90} star="var(--white)" hole="var(--lapis)" dot="var(--white)" opacity={0.09} />
    <div class="wrap intro-inner">
      <p class="label">Blog</p>
      <h1>Ustaxona daftari</h1>
      <p>Saytlar, Telegram botlar va AI haqida — oddiy tilda, biznes egalari uchun.</p>
    </div>
  </section>

  <div class="wrap body">
    {showChips && (
      <div role="group" aria-label="Mavzular" class="chips" data-chips>
        <button type="button" aria-pressed="true" data-topic="all">Hammasi</button>
        {used.map((t) => (
          <button type="button" aria-pressed="false" data-topic={t.id}>{t.label}</button>
        ))}
      </div>
    )}

    {latest && (
      <div data-topic-item={latest.data.topic}>
        <Featured post={latest} label="Yangi" />
      </div>
    )}

    {rest.length > 0 && (
      <div class="grid">
        {rest.map((p) => (
          <div data-topic-item={p.data.topic}><PostCard post={p} excerpt /></div>
        ))}
      </div>
    )}

    {posts.length === 0 && <p class="empty">Birinchi maqola tez orada.</p>}
  </div>

  <Subscribe />
</Base>

<script>
  const group = document.querySelector<HTMLElement>('[data-chips]');
  if (group) {
    const buttons = group.querySelectorAll<HTMLButtonElement>('button');
    const items = document.querySelectorAll<HTMLElement>('[data-topic-item]');
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      const topic = btn.dataset.topic;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((el) => {
        el.hidden = topic !== 'all' && el.dataset.topicItem !== topic;
      });
    });
  }
</script>

<style>
  .intro {
    position: relative;
    overflow: hidden;
    background: var(--lapis);
    color: var(--white);
  }
  .intro .label {
    color: var(--saffron);
  }
  .intro-inner {
    position: relative;
    padding-block: 80px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(44px, 7vw, 96px);
    line-height: 1;
    letter-spacing: -2px;
  }
  .intro-inner p:not(.label) {
    margin: 0;
    max-width: 560px;
    font-size: 20px;
    line-height: 1.5;
    color: var(--on-dark);
  }
  .body {
    padding-block: 56px 96px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips button {
    font: 500 15px var(--sans);
    padding: 0 18px;
    min-height: 44px;
    border-radius: 999px;
    cursor: pointer;
    background: var(--white);
    color: var(--ink);
    border: 1.5px solid var(--line-strong);
  }
  .chips button[aria-pressed='true'] {
    background: var(--lapis);
    color: var(--white);
    border-color: var(--lapis);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px 32px;
  }
  .empty {
    font-size: 19px;
  }
  @media (max-width: 760px) {
    .intro-inner {
      padding-block: 56px;
    }
    .body {
      padding-block: 36px 64px;
    }
  }
</style>
