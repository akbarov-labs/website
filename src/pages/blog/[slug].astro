---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import PostThumb from '../../components/PostThumb.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, formatDate, readingMinutes, postUrl, topics, type Post } from '../../data/blog';
import { site, contactHref, contactLabel } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: posts.filter((p) => p.id !== post.id).slice(0, 2) },
  }));
}

interface Props {
  post: Post;
  related: Post[];
}
const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const url = new URL(postUrl(post), site.url).href;
const topicLabel = topics.find((t) => t.id === post.data.topic)?.label ?? post.data.topic;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.published.toISOString(),
  inLanguage: 'uz',
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: site.founder },
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: `${site.url}/icon-512.png` } },
};
---
<Base
  title={`${post.data.title} — Akbarov Labs`}
  description={post.data.description}
  current="blog"
  type="article"
  published={post.data.published}
  jsonLd={jsonLd}
>
  <header class="wrap head">
    <nav aria-label="Joylashuv" class="crumbs">
      <a href="/blog/">Blog</a><span aria-hidden="true">/</span><span>{topicLabel}</span>
    </nav>
    <h1>{post.data.title}</h1>
    <div class="byline">
      <span class="avatar"><Mark size={24} /></span>
      <span class="who">{site.founder}</span>
      <span class="when">
        <time datetime={post.data.published.toISOString().slice(0, 10)}>{formatDate(post.data.published)}</time>{' · '}{readingMinutes(post.body)} daqiqada oʻqiladi
      </span>
    </div>
  </header>

  <div class="wrap cover"><PostThumb topic={post.data.topic} id={`g-cover-${post.id}`} height="100%" /></div>

  <div class="wrap body">
    <aside class="side">
      {toc.length > 1 && (
        <nav aria-label="Mundarija" class="box">
          <span class="box-title">Mundarija</span>
          {toc.map((h, i) => (
            <a href={`#${h.slug}`}><span class="n">{String(i + 1).padStart(2, '0')}</span>{h.text}</a>
          ))}
        </nav>
      )}
      <div class="box">
        <span class="box-title">Ulashish</span>
        <a href={`https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(post.data.title)}`} rel="noopener">Telegram</a>
        <button type="button" class="copy" data-copy={url}>Havolani nusxalash</button>
      </div>
    </aside>

    <article class="prose">
      <Content />

      <div class="cta">
        <p>{post.data.topic === 'TELEGRAM' ? 'Sizga bot kerakmi yoki yoʻqmi — qisqa suhbatda birga aniqlaymiz.' : 'Loyihangiz haqida qisqa suhbatda birga oʻylab koʻramiz.'}</p>
        <a href={contactHref} class="btn btn-saffron">{contactLabel}</a>
      </div>

      <div class="author">
        <div class="author-pic">
          {site.founderPhoto ? <img src={site.founderPhoto} alt="" /> : <Mark size={30} />}
        </div>
        <div>
          <strong>{site.founder}</strong>
          <span>Akbarov Labs asoschisi. Saytlar, Telegram botlar va AI yechimlari quradi.</span>
        </div>
      </div>
    </article>
  </div>

  {related.length > 0 && (
    <section class="related">
      <div class="wrap">
        <div class="section-head">
          <h2>Yana oʻqing</h2>
          <a href="/blog/" class="all">Barcha maqolalar →</a>
        </div>
        <div class="related-grid">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? location.href);
        const old = btn.textContent;
        btn.textContent = 'Nusxalandi ✓';
        setTimeout(() => (btn.textContent = old), 2000);
      } catch {
        prompt('Havola:', btn.dataset.copy ?? location.href);
      }
    });
  });
</script>

<style>
  .head {
    padding-block: 48px 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    max-width: 1000px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(32px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    font-size: 15px;
  }
  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--mist);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .who {
    font-weight: 600;
  }
  .when {
    color: var(--muted);
  }
  .cover {
    height: 400px;
  }
  .cover :global(.thumb) {
    border-radius: 28px;
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
    padding-block: 56px 96px;
  }
  .side {
    flex: 1 1 240px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-self: flex-start;
  }
  .box {
    background: var(--mist);
    border-radius: 18px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 15px;
  }
  .box-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 8px;
  }
  .box a,
  .copy {
    color: var(--ink);
    text-decoration: none;
    padding: 7px 0;
    display: flex;
    gap: 10px;
  }
  .n {
    color: var(--lapis);
    font-weight: 600;
  }
  .copy {
    font: inherit;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
  }
  .box a:hover,
  .copy:hover {
    color: var(--lapis);
  }

  .prose {
    flex: 3 1 560px;
    min-width: 0;
    max-width: 760px;
    font-size: 19px;
    line-height: 1.7;
    color: #2a3140;
  }
  .prose :global(> p:first-child) {
    margin-top: 0;
    font-size: 22px;
    line-height: 1.6;
    color: var(--ink);
  }
  .prose :global(p) {
    margin: 0 0 16px;
  }
  .prose :global(h2) {
    margin: 48px 0 16px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    scroll-margin-top: 24px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 24px;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .prose :global(li::marker) {
    color: var(--lapis);
    font-weight: 600;
  }
  .prose :global(blockquote) {
    margin: 32px 0;
    padding: 28px 32px;
    background: var(--mist);
    border-radius: 20px;
    font-family: var(--display);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.4;
    color: var(--ink);
  }
  .prose :global(blockquote p) {
    margin: 0;
  }

  .cta {
    margin-top: 40px;
    border-radius: 24px;
    padding: 32px;
    background: var(--lapis);
    color: var(--white);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .cta p {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.35;
  }
  .author {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 16px;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.55;
  }
  .author > div:last-child {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .author span {
    color: var(--body);
  }
  .author-pic {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 16px;
    background: var(--mist);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .author-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related {
    background: var(--mist);
    padding-block: 72px;
  }
  .all {
    font-weight: 600;
    padding: 12px 0;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px 32px;
  }

  @media (max-width: 760px) {
    .head {
      padding-top: 32px;
    }
    .cover {
      height: 220px;
    }
    .body {
      padding-block: 32px 64px;
    }
    .prose {
      font-size: 18px;
    }
    .prose :global(> p:first-child) {
      font-size: 20px;
    }
    .prose :global(blockquote) {
      padding: 22px;
      font-size: 19px;
    }
    .cta {
      padding: 24px;
    }
    .cta p {
      font-size: 19px;
    }
  }
</style>
