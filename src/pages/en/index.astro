---
// English "About" page for partners, startup programs and anyone who doesn't read Uzbek.
// The product list mirrors src/data/works.ts; the text here is English, so it lives on this page.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import Girih from '../../components/Girih.astro';
import kitoblarim from '../../assets/kitoblarim.png';
import olgo from '../../assets/works/olgo.png';
import alifbo from '../../assets/works/alifbo.png';
import aktivYodla from '../../assets/works/aktiv-yodla.png';
import posbon from '../../assets/works/posbon.png';
import birgaolamizmi from '../../assets/works/birgaolamizmi.png';
import { site } from '../../data/site';
import { works } from '../../data/works';

const description =
  'Akbarov Labs is a software and AI studio in Uzbekistan. We build websites, Telegram bots, CRM systems and AI assistants for small businesses, and run our own Telegram-first products.';

const services = [
  {
    title: 'Websites',
    text: 'Landing pages, company sites and online stores. Fast, mobile-first and easy to find on Google.',
  },
  {
    title: 'Telegram bots',
    text: 'Orders, bookings, payments and notifications inside the app our customers already open every day.',
  },
  {
    title: 'CRM systems',
    text: 'Customers, orders and reports in one place, replacing spreadsheets and paper notebooks.',
  },
  {
    title: 'AI assistants',
    text: 'Bots that answer customers around the clock, sort incoming requests and answer questions about the numbers.',
  },
];

// English text for each product in src/data/works.ts, by id.
const english: Record<string, { kind: string; text: string }> = {
  olgo: {
    kind: 'Website + Telegram bot',
    text: 'An online store inside Telegram for Instagram sellers. Customers pay with Payme, Click or cash, and orders arrive on the seller’s phone.',
  },
  alifbo: {
    kind: 'Website + Telegram bot',
    text: 'Converts Uzbek text between Cyrillic, Latin and the new alphabet, including Word, PDF, PowerPoint and Excel files.',
  },
  'aktiv-yodla': {
    kind: 'Telegram Mini App',
    text: 'Teaches English vocabulary by use: every new word goes straight into your own sentence, then comes back just before you would forget it.',
  },
  posbon: {
    kind: 'Telegram bot',
    text: 'Protects Telegram groups with captcha for new members and spam and ad filtering, all configured in a private chat with the bot.',
  },
  birgaolamizmi: {
    kind: 'Telegram bot + Mini App',
    text: 'Group buying: people pool together on one product to get the wholesale price. If the group doesn’t fill, nobody pays.',
  },
};

const logos = { olgo, alifbo, 'aktiv-yodla': aktivYodla, posbon, birgaolamizmi };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  email: site.email,
  description,
  founder: { '@type': 'Person', name: site.founder },
  address: { '@type': 'PostalAddress', addressCountry: 'UZ' },
  sameAs: [site.instagram && `https://instagram.com/${site.instagram}`, site.telegram && `https://t.me/${site.telegram}`].filter(Boolean),
};
---
<Base title="About Akbarov Labs — software and AI studio in Uzbekistan" description={description} lang="en" current="other" jsonLd={jsonLd}>
  <!-- Intro -->
  <section class="intro">
    <Girih id="g-en" tile={110} star="var(--white)" hole="var(--lapis)" dot="var(--white)" opacity={0.09} />
    <div class="wrap intro-inner">
      <p class="label">Software &amp; AI studio · Uzbekistan</p>
      <h1>About Akbarov Labs</h1>
      <p class="lead">
        We are a digital workshop in Uzbekistan. We build websites, Telegram bots and business systems for small
        businesses, connect them to AI, and run our own products for people who live in Telegram.
      </p>
      <div class="row">
        <a href={`mailto:${site.email}`} class="btn btn-saffron">{site.email}</a>
        <a href="#products" class="btn btn-ghost">Our products</a>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="wrap section why">
    <div class="why-head">
      <p class="label">Why we exist</p>
      <h2 class="h2">Uzbekistan runs on Telegram. Its software should too.</h2>
    </div>
    <div class="why-text">
      <p>
        Most small businesses in Uzbekistan sell, book and talk to customers in Telegram and Instagram, not on websites.
        The tools they get are usually made for other markets and other languages.
      </p>
      <p>
        We build for how people here actually work: Telegram-first, mobile-first, in Uzbek and Russian, with local
        payments like Payme and Click. AI is the next step: assistants that reply to customers around the clock and
        take routine work off small teams.
      </p>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="services-band" aria-labelledby="services-title">
    <div class="wrap section">
      <div class="section-head">
        <div>
          <p class="label">What we do</p>
          <h2 id="services-title">Services</h2>
        </div>
      </div>
      <div class="services">
        {services.map((s) => (
          <div class="service">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="wrap section">
    <div class="section-head">
      <div>
        <p class="label">Live products</p>
        <h2>What we have shipped</h2>
      </div>
    </div>

    <article class="work">
      <div class="work-pic">
        <Image src={kitoblarim} alt="Kitoblarim logo" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 640px" />
      </div>
      <div class="work-text">
        <p class="meta"><span class="live" aria-hidden="true"></span>Live · Telegram bot + Mini App · 3 languages</p>
        <h3>Kitoblarim</h3>
        <p>
          A free Telegram app that helps people finish the books they start. You pick a finish date, and the app works
          out how many pages to read each day and reminds you in Telegram.
        </p>
        <ul>
          <li>Personal and family libraries, with books added by barcode</li>
          <li>Reading marathons in Telegram groups</li>
          <li>Audiobook player</li>
          <li>Recommendations for what to read next</li>
        </ul>
        <div class="ext-row">
          <a href="https://t.me/kitob_javonim_bot" class="ext" rel="noopener">@kitob_javonim_bot →</a>
          <a href="https://kitoblarim.uz" class="ext" rel="noopener">kitoblarim.uz →</a>
        </div>
      </div>
    </article>

    <ul class="works" role="list">
      {works.map((w) => (
        <li>
          <a href={w.href} class="w-card" rel="noopener">
            <Image src={logos[w.id as keyof typeof logos]} alt="" width={56} height={56} densities={[1, 2]} class="w-logo" />
            <p class="meta"><span class="live" aria-hidden="true"></span>Live · {english[w.id]?.kind ?? w.kind}</p>
            <h3>{w.name}</h3>
            <p class="w-text">{english[w.id]?.text ?? w.text}</p>
            <span class="w-link">{w.linkText} →</span>
          </a>
        </li>
      ))}
      <li>
        <a href="#contact" class="next">
          <span class="next-text">Your project could be next.</span>
          <span class="next-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </section>

  <!-- Founder -->
  <section class="founder-band">
    <div class="wrap section founder">
      <div class="founder-pic">
        {site.founderPhoto ? (
          <img src={site.founderPhoto} alt={site.founder} loading="lazy" />
        ) : (
          <span class="founder-mark"><Mark size={110} /></span>
        )}
      </div>
      <div class="founder-text">
        <p class="label">Who builds it</p>
        <h2 class="h2">{site.founder}</h2>
        <p>
          Founder of Akbarov Labs. I lead every project myself and write the code, so clients talk to the person
          building their product, not a manager. We use modern AI tools such as Claude in our daily work to ship
          faster and test more.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact dark">
    <div class="wrap contact-inner">
      <p class="label">Contact</p>
      <h2>Get in touch.</h2>
      <p>Partnerships, programs and projects: write to us by email.</p>
      <div class="contact-links">
        <a href={`mailto:${site.email}`} class="btn btn-saffron">{site.email}</a>
        {site.telegram && <a href={`https://t.me/${site.telegram}`} rel="noopener">Telegram</a>}
        {site.instagram && <a href={`https://instagram.com/${site.instagram}`} rel="noopener">@{site.instagram}</a>}
        <a href="/" lang="uz">Oʻzbekcha sayt →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    position: relative;
    overflow: hidden;
    background: var(--lapis);
    color: var(--white);
  }
  .intro .label {
    color: var(--saffron);
  }
  .intro-inner {
    position: relative;
    padding-block: 104px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 80px);
    line-height: 1.05;
    letter-spacing: -1.5px;
  }
  .lead {
    margin: 0;
    max-width: 720px;
    font-size: 21px;
    line-height: 1.55;
    color: var(--on-dark);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .btn-ghost {
    border-color: var(--white);
    color: var(--white);
  }
  .btn-ghost:hover {
    background: var(--white);
    color: var(--lapis);
  }

  .why {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
  }
  .why-head {
    flex: 1 1 420px;
    min-width: 0;
  }
  .why-text {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .why-text p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--body);
  }

  .services-band {
    background: var(--mist);
  }
  /* Four cards: one row when wide, two by two in between, a single column on phones. */
  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  @media (min-width: 1100px) {
    .services {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .services {
      grid-template-columns: 1fr;
    }
  }
  .service {
    background: var(--white);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .service h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: 20px;
  }
  .service p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--body);
  }

  .work {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 56px;
    align-items: center;
  }
  .work-pic {
    flex: 1 1 480px;
    min-width: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: #161c19;
  }
  .work-pic :global(img) {
    width: 100%;
    height: auto;
  }
  .work-text {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .meta {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .live {
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 50%;
    background: #1f9d55;
  }
  .work-text h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(36px, 4vw, 52px);
    letter-spacing: -1px;
  }
  .work-text p:not(.meta) {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--body);
  }
  .work-text ul {
    margin: 0;
    padding-left: 20px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--body);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .work-text li::marker {
    color: var(--saffron);
  }
  .ext-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
  }
  .ext {
    font-weight: 600;
    padding: 8px 0;
  }
  .works {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  .w-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .w-card:hover {
    border-color: var(--lapis);
    color: var(--ink);
  }
  .w-logo {
    width: 56px;
    height: 56px;
    margin-bottom: 4px;
    border-radius: 16px;
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }
  .w-card h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: 22px;
  }
  .w-text {
    flex: 1;
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--body);
  }
  .w-link {
    font-weight: 600;
    color: var(--lapis);
    overflow-wrap: anywhere;
  }

  /* The last cell of the works grid, so five products plus this make full rows. */
  .next {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 28px;
    border-radius: var(--radius);
    border: 2px dashed var(--line-strong);
    color: var(--ink);
    text-decoration: none;
  }
  .next:hover {
    border-color: var(--lapis);
    color: var(--lapis);
  }
  .next-text {
    font-family: var(--display);
    font-weight: 500;
    font-size: 22px;
  }
  .next-arrow {
    align-self: flex-end;
    font-size: 28px;
  }

  .founder-band {
    border-top: 1px solid var(--line);
  }
  .founder {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 56px;
    align-items: center;
  }
  .founder-pic {
    flex: 0 0 200px;
    height: 200px;
    border-radius: var(--radius);
    background: var(--mist);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .founder-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founder-mark {
    display: flex;
  }
  .founder-text {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .founder-text .h2 {
    margin: 0;
  }
  .founder-text p:not(.label) {
    margin: 0;
    max-width: 680px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--body);
  }

  .contact-inner {
    padding-block: 96px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .contact h2 {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(48px, 8vw, 112px);
    line-height: 0.95;
    letter-spacing: -2px;
  }
  .contact-inner p:not(.label) {
    margin: 0;
    max-width: 560px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--on-dark);
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    align-items: center;
    font-size: 18px;
  }
  .contact-links a:not(.btn) {
    padding: 12px 0;
  }

  @media (max-width: 760px) {
    .intro-inner,
    .contact-inner {
      padding-block: 64px;
    }
    .lead {
      font-size: 18px;
    }
    .founder-pic {
      flex-basis: 140px;
      height: 140px;
    }
    .service {
      padding: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w-card {
      transition: none;
    }
  }
</style>
