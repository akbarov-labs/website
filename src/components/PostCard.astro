---
import PostThumb from './PostThumb.astro';
import { formatDate, postUrl, readingMinutes, topics, type Post } from '../data/blog';

interface Props {
  post: Post;
  excerpt?: boolean;
}
const { post, excerpt = false } = Astro.props;
const topic = topics.find((t) => t.id === post.data.topic)?.label ?? post.data.topic;
---
<a href={postUrl(post)} class="card">
  <PostThumb topic={post.data.topic} id={`g-card-${post.id}`} />
  <span class="meta"><span class="topic">{topic}</span> · {formatDate(post.data.published)} · {readingMinutes(post.body)} daq</span>
  <h3>{post.data.title}</h3>
  {excerpt && <p>{post.data.description}</p>}
</a>

<style>
  .card {
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card:hover {
    color: var(--ink);
  }
  .card:hover h3 {
    color: var(--lapis);
  }
  .meta {
    font-size: 14px;
    color: var(--muted);
  }
  .topic {
    color: var(--lapis);
    font-weight: 600;
  }
  h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.3;
  }
  p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--body);
  }
</style>
