---
import Girih from './Girih.astro';
import { site, contactHref, contactLabel } from '../data/site';
// With a channel set this asks people to subscribe; without one it invites them to write.
const channel = site.telegramChannel;
---
<section class="sub">
  <Girih id="g-sub" tile={80} star="var(--white)" hole="var(--lapis)" dot="var(--white)" opacity={0.09} />
  <div class="wrap inner">
    <div class="text">
      <p class="label">{channel ? 'Obuna' : 'Aloqa'}</p>
      {channel ? (
        <>
          <h2 class="h2">Yangi maqolalarni Telegramda oling</h2>
          <p>Haftasiga koʻpi bilan bitta xabar. Reklama yoʻq.</p>
        </>
      ) : (
        <>
          <h2 class="h2">Savolingiz bormi? Yozing</h2>
          <p>Vazifani birga koʻrib chiqamiz va narxini aytamiz.</p>
        </>
      )}
    </div>
    {channel ? (
      <a href={`https://t.me/${channel}`} class="btn btn-saffron" rel="noopener">Kanalga obuna boʻlish</a>
    ) : (
      <a href={contactHref} class="btn btn-saffron">{contactLabel}</a>
    )}
  </div>
</section>

<style>
  .sub {
    position: relative;
    overflow: hidden;
    background: var(--lapis);
    color: var(--white);
  }
  .sub .label {
    color: var(--saffron);
  }
  .inner {
    position: relative;
    padding-block: 72px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: center;
    justify-content: space-between;
  }
  .text {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .text p:not(.label) {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--on-dark);
  }
</style>
