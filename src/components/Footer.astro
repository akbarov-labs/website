---
import Mark from './Mark.astro';

interface Props {
  lang?: 'uz' | 'en';
}
const en = Astro.props.lang === 'en';
---
<footer class="foot dark">
  <div class="wrap row">
    <a href={en ? '/en/' : '/'} class="brand" aria-label={en ? 'Akbarov Labs — home' : 'Akbarov Labs — bosh sahifa'}>
      <Mark size={28} ink="var(--white)" stem="var(--saffron)" spark="var(--saffron)" />
      <span>akbarov labs</span>
    </a>
    <span>© {new Date().getFullYear()} Akbarov Labs · akbarovlabs.uz</span>
    {en ? <a href="/" hreflang="uz" lang="uz">Oʻzbekcha</a> : <a href="/en/" hreflang="en" lang="en">English</a>}
    <span>{en ? 'Built with Claude' : 'Claude bilan qurilgan'}</span>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 32px;
    padding-block: 24px;
    font-size: 14px;
    color: var(--on-dark);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--display);
    font-weight: 700;
    font-size: 16px;
  }
</style>
