---
// The site's AI assistant. The page is static, so the card is built as a
// sample conversation, clearly marked as one; the script below asks the
// assistant service (assistant/) whether it is on and, if so, turns the card
// into a live chat. If the service is off or unreachable, the sample stays.
import Mark from './Mark.astro';
import { contactHref, contactLabel } from '../data/site';

const messages = [
  { me: true, text: 'Salom! Klinikam uchun qabulga yozadigan bot kerak. Qancha vaqt ketadi?' },
  { me: false, text: 'Salom! Muddat vazifaga bogʻliq — qisqa suhbatda aniq aytamiz. Shifokorlaringiz nechta va toʻlovni bot orqali olasizmi?' },
  { me: true, text: '3 ta shifokor. Toʻlov hozircha kerak emas.' },
  { me: false, text: 'Tushunarli. Ismingiz va Telegramingizni qoldiring — arizangizni Sarvarga yuboraman, u oʻzi yozadi.' },
];
---
<figure class="chat" aria-label="AI yordamchi bilan namuna suhbat" data-assistant>
  <div class="top">
    <span class="avatar"><Mark size={24} /></span>
    <span class="who">
      <span class="name">Ustaxona yordamchisi</span>
      <span class="sub">AI · savollarga darhol javob beradi</span>
    </span>
    <span class="badge" data-badge>Namuna</span>
  </div>
  <div class="msgs" data-msgs>
    {messages.map((m) => <p class:list={['msg', m.me ? 'me' : 'bot']}>{m.text}</p>)}
    <div class="chips">
      <a href="#narxlar">Sayt narxi qancha?</a>
      <a href="/blog/telegram-bot-qachon-kerak/">Bot nima qila oladi?</a>
      <a href="#ishlar">Ishlaringizni koʻrsating</a>
    </div>
  </div>
  <div class="captcha" data-captcha hidden></div>
  <form class="ask" data-form hidden>
    <label for="assistant-input" class="sr-only">Savolingiz</label>
    <textarea id="assistant-input" rows="1" maxlength="1000" placeholder="Savolingizni yozing…" data-input></textarea>
    <button type="submit" class="send" aria-label="Yuborish" data-send>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
  </form>
  <div class="bottom">
    <span data-note>AI yordamchi tez orada shu yerda javob beradi. Hozircha:</span>
    <a href={contactHref} class="btn btn-primary btn-sm">{contactLabel}</a>
  </div>
</figure>

<script>
  // Live mode. Plain text only: everything the assistant or a visitor writes
  // goes into the page as text nodes, links included, never as HTML.

  type Config = { enabled: boolean; turnstileSiteKey: string | null };
  type Turnstile = {
    render: (el: HTMLElement, options: Record<string, unknown>) => string;
    reset: (id: string) => void;
  };

  const greeting =
    'Salom! Men Akbarov Labs yordamchisiman. Xizmatlar, narxlar yoki ishlarimiz haqida soʻrang — xohlasangiz, loyihangizni Sarvarga yetkazaman.';
  const starters = ['Sayt narxi qancha?', 'Bot nima qila oladi?', 'Ishlaringizni koʻrsating'];
  const errors: Record<string, string> = {
    too_long: 'Xabar juda uzun: 1000 belgigacha yozing.',
    rate_limited: 'Juda koʻp xabar yuborildi. Birozdan keyin qayta urinib koʻring yoki Sarvarga toʻgʻridan-toʻgʻri yozing.',
    conversation_full: 'Bu suhbatdagi xabarlar chegarasi tugadi. Davom ettirish uchun Sarvarga toʻgʻridan-toʻgʻri yozing.',
    budget: 'Yordamchi bugungi limitga yetdi. Sarvarga toʻgʻridan-toʻgʻri yozing — u oʻzi javob beradi.',
    captcha: 'Tekshiruvdan oʻtib boʻlmadi. Sahifani yangilab, qayta urinib koʻring.',
    unavailable: 'Hozir javob bera olmayapman. Birozdan keyin qayta urinib koʻring yoki Sarvarga toʻgʻridan-toʻgʻri yozing.',
  };
  // Errors after which this conversation can't go on.
  const final = new Set(['conversation_full', 'budget']);

  const card = document.querySelector<HTMLElement>('[data-assistant]');
  if (card) start(card);

  async function start(card: HTMLElement) {
    let config: Config;
    try {
      const response = await fetch('/api/assistant/config');
      if (!response.ok) return;
      config = await response.json();
    } catch {
      return;
    }
    if (!config.enabled) return;

    const msgs = card.querySelector<HTMLElement>('[data-msgs]')!;
    const form = card.querySelector<HTMLFormElement>('[data-form]')!;
    const input = card.querySelector<HTMLTextAreaElement>('[data-input]')!;
    const sendButton = card.querySelector<HTMLButtonElement>('[data-send]')!;
    const captchaBox = card.querySelector<HTMLElement>('[data-captcha]')!;
    let conversationId: string | null = null;
    let busy = false;
    let closed = false;
    const captcha = config.turnstileSiteKey ? turnstile(captchaBox, config.turnstileSiteKey) : null;

    card.classList.add('live');
    card.setAttribute('aria-label', 'AI yordamchi bilan suhbat');
    card.querySelector('[data-badge]')!.remove();
    card.querySelector('[data-note]')!.textContent = 'AI javob beradi va xato qilishi mumkin.';
    msgs.replaceChildren();
    msgs.setAttribute('aria-live', 'polite');
    bubble('bot', greeting);
    const chips = document.createElement('div');
    chips.className = 'chips';
    for (const text of starters) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.textContent = text;
      chip.addEventListener('click', () => send(text));
      chips.append(chip);
    }
    msgs.append(chips);
    form.hidden = false;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      send(input.value);
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
        event.preventDefault();
        send(input.value);
      }
    });
    input.addEventListener('input', grow);

    function grow() {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
    }

    function bubble(who: 'me' | 'bot', text = '') {
      const p = document.createElement('p');
      p.className = `msg ${who}`;
      p.textContent = text;
      msgs.append(p);
      msgs.scrollTop = msgs.scrollHeight;
      return p;
    }

    function setBusy(value: boolean) {
      busy = value;
      sendButton.disabled = value || closed;
      input.disabled = closed;
    }

    async function send(raw: string) {
      const message = raw.trim();
      if (!message || busy || closed) return;
      chips.remove();
      input.value = '';
      grow();
      bubble('me', message);
      const reply = bubble('bot');
      reply.classList.add('typing');
      setBusy(true);

      let text = '';
      let error: string | null = null;
      try {
        const token = conversationId || !captcha ? undefined : await captcha.token();
        const response = await fetch('/api/assistant/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ conversationId, message, turnstileToken: token }),
        });
        if (!response.ok || !response.body) {
          error = (await response.json().catch(() => null))?.error ?? 'unavailable';
        } else {
          for await (const [event, data] of events(response.body)) {
            if (event === 'start') conversationId = data.conversationId;
            if (event === 'text') {
              text += data.delta;
              reply.classList.remove('typing');
              reply.textContent = text;
              msgs.scrollTop = msgs.scrollHeight;
            }
            if (event === 'done' && data.left === 0) error = 'conversation_full';
            if (event === 'error') error = data.error;
          }
        }
      } catch {
        error = 'unavailable';
      }
      reply.classList.remove('typing');
      if (text) linkify(reply, text);
      if (error) {
        if (!text) reply.remove();
        bubble('bot', errors[error] ?? errors.unavailable).classList.add('note');
        if (final.has(error)) closed = true;
        // A refused token is spent; the next try needs a fresh one.
        if (error === 'captcha') captcha?.reset();
      }
      setBusy(false);
      if (!closed) input.focus({ preventScroll: true });
    }
  }

  // Server-sent events from a fetch body, as [event, data] pairs.
  async function* events(body: ReadableStream<Uint8Array>): AsyncGenerator<[string, any]> {
    const reader = body.pipeThrough(new TextDecoderStream()).getReader();
    let buffer = '';
    for (;;) {
      const { value, done } = await reader.read();
      if (done) return;
      buffer += value;
      let end: number;
      while ((end = buffer.indexOf('\n\n')) !== -1) {
        const block = buffer.slice(0, end);
        buffer = buffer.slice(end + 2);
        const event = /^event: (.*)$/m.exec(block)?.[1];
        const data = /^data: (.*)$/m.exec(block)?.[1];
        if (event && data) yield [event, JSON.parse(data)];
      }
    }
  }

  // Replaces the bubble's text with the same text, its web addresses made into links.
  function linkify(el: HTMLElement, text: string) {
    el.replaceChildren();
    for (const part of text.split(/(https?:\/\/[^\s)]+[^\s).,!?;:'"])/)) {
      if (/^https?:\/\//.test(part)) {
        const a = document.createElement('a');
        a.href = part;
        a.textContent = part;
        a.rel = 'noopener';
        a.target = '_blank';
        el.append(a);
      } else if (part) {
        el.append(part);
      }
    }
  }

  // Cloudflare Turnstile, loaded only when the assistant is on. It stays
  // invisible unless Cloudflare wants the visitor to click.
  function turnstile(box: HTMLElement, siteKey: string) {
    let widgetId: string | null = null;
    let current: string | null = null;
    let waiting: ((token: string) => void)[] = [];
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.addEventListener('load', () => {
      const api = (window as unknown as { turnstile: Turnstile }).turnstile;
      widgetId = api.render(box, {
        sitekey: siteKey,
        appearance: 'interaction-only',
        'before-interactive-callback': () => (box.hidden = false),
        callback: (token: string) => {
          current = token;
          box.hidden = true;
          waiting.forEach((resolve) => resolve(token));
          waiting = [];
        },
        'expired-callback': () => (current = null),
      });
    });
    document.head.append(script);
    return {
      // Waits up to 20 seconds; without a token the server answers "captcha".
      token: () =>
        current
          ? Promise.resolve(current)
          : Promise.race([
              new Promise<string>((resolve) => waiting.push(resolve)),
              new Promise<undefined>((resolve) => setTimeout(resolve, 20_000)),
            ]),
      reset: () => {
        current = null;
        if (widgetId) (window as unknown as { turnstile: Turnstile }).turnstile.reset(widgetId);
      },
    };
  }
</script>

<style>
  .chat {
    position: relative;
    margin: 0;
    width: 100%;
    background: var(--white);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(18, 24, 38, 0.25);
  }
  .top {
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 12px;
    background: var(--mist);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .who {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .name {
    font-family: var(--display);
    font-weight: 500;
    font-size: 15px;
  }
  .sub {
    font-size: 13px;
    color: var(--muted);
  }
  .badge {
    background: var(--saffron);
    border-radius: 8px;
    padding: 5px 9px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .msgs {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
  }
  .msgs :global(.msg) {
    margin: 0;
    max-width: 86%;
    padding: 11px 15px;
  }
  .msgs :global(.me) {
    align-self: flex-end;
    background: var(--lapis);
    color: var(--white);
    border-radius: 16px 16px 4px 16px;
  }
  .msgs :global(.bot) {
    align-self: flex-start;
    background: var(--mist);
    border-radius: 16px 16px 16px 4px;
  }
  .msgs :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 6px;
  }
  .msgs :global(.chips a),
  .msgs :global(.chips button) {
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    padding: 9px 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .msgs :global(.chips a:hover),
  .msgs :global(.chips button:hover) {
    border-color: var(--lapis);
    color: var(--lapis);
  }
  .msgs :global(.chips button) {
    background: none;
    font-family: inherit;
    cursor: pointer;
  }

  /* Live chat: a fixed-height conversation that scrolls, and an input row. */
  .live .msgs {
    height: 360px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .live .msgs :global(.msg) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .msgs :global(.bot a) {
    color: var(--lapis);
  }
  .msgs :global(.note) {
    background: none;
    border: 1.5px dashed var(--line-strong);
    color: var(--body);
  }
  /* Three dots while the first words of a reply are on their way. */
  .msgs :global(.typing) {
    min-width: 58px;
    min-height: 44px;
    background-image: radial-gradient(circle, var(--muted) 3px, transparent 3.5px);
    background-size: 12px 12px;
    background-repeat: space no-repeat;
    background-position: center;
    background-origin: content-box;
    animation: pulse 1.2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.45;
    }
  }
  .captcha {
    padding: 0 20px 12px;
  }
  .ask {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 12px 16px 12px 20px;
    border-top: 1px solid var(--line);
  }
  .ask textarea {
    flex: 1;
    min-width: 0;
    resize: none;
    border: 0;
    padding: 10px 0;
    font: inherit;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink);
    background: none;
  }
  .ask textarea:focus {
    outline: none;
  }
  .ask:focus-within {
    box-shadow: inset 0 2px 0 var(--lapis);
  }
  .send {
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 12px;
    background: var(--lapis);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .send:hover {
    background: var(--lapis-dark);
  }
  .send:disabled {
    background: var(--line-strong);
    cursor: default;
  }
  .send:focus-visible {
    outline: 2px solid var(--saffron);
    outline-offset: 2px;
  }
  .bottom {
    padding: 14px 16px 14px 20px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .msgs {
      padding: 16px;
      font-size: 14px;
    }
    .msgs :global(.msg) {
      max-width: 92%;
    }
    .bottom .btn {
      width: 100%;
    }
    .live .msgs {
      height: 320px;
    }
    .ask {
      padding-left: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .msgs :global(.typing) {
      animation: none;
    }
  }
</style>
