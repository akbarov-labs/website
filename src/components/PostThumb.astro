---
import Girih from './Girih.astro';
import type { Topic } from '../data/blog';

interface Props {
  topic: Topic;
  id: string;
  height?: string;
}
const { topic, id, height = '220px' } = Astro.props;
// Each topic gets its own colourway of the girih tile.
const look = {
  TELEGRAM: { bg: 'var(--lapis)', star: 'var(--saffron)', hole: 'var(--lapis)', dot: 'var(--white)', icon: 'var(--lapis)' },
  AI: { bg: 'var(--saffron)', star: 'var(--white)', hole: 'var(--saffron)', dot: 'var(--lapis)', icon: 'var(--ink)' },
  SAYTLAR: { bg: 'var(--mist)', star: 'var(--lapis)', hole: 'var(--mist)', dot: 'var(--saffron)', icon: 'var(--lapis)' },
  BIZNES: { bg: 'var(--ink)', star: 'var(--saffron)', hole: 'var(--ink)', dot: 'var(--lapis)', icon: 'var(--ink)' },
}[topic];
---
<div class="thumb" style={`height: ${height}; background: ${look.bg}`} aria-hidden="true">
  <Girih id={id} tile={90} star={look.star} hole={look.hole} dot={look.dot} opacity={0.9} />
  <span class="icon" style={`color: ${look.icon}`}>
    {topic === 'TELEGRAM' && <svg viewBox="0 0 24 24" width="56" height="56"><path fill="currentColor" d="M21 4 3 11l6.5 2.2L19 7l-7.2 7.3.4 5.7 3.3-4.1L19.5 19z" /></svg>}
    {topic === 'AI' && <svg viewBox="0 0 24 24" width="56" height="56"><path fill="currentColor" d="M12 0c.8 6.3 4.7 10.2 12 12-7.3 1.8-11.2 5.7-12 12-.8-6.3-4.7-10.2-12-12C7.3 10.2 11.2 6.3 12 0z" /></svg>}
    {topic === 'SAYTLAR' && <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2.5" /><path d="M3 9h18" /></svg>}
    {topic === 'BIZNES' && <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><path d="M14 15h7M14 18h5M14 21h7" /></svg>}
  </span>
</div>

<style>
  .thumb {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .icon {
    position: relative;
    width: 104px;
    height: 104px;
    border-radius: 28px;
    background: var(--white);
    box-shadow: 0 12px 32px rgba(18, 24, 38, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
