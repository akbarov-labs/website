---
import Mark from './Mark.astro';

interface Props {
  current?: 'home' | 'blog' | 'other';
  lang?: 'uz' | 'en';
}
const { current = 'home', lang = 'uz' } = Astro.props;
const en = lang === 'en';
// On the home page the section links are plain anchors; elsewhere they go back home.
const home = current === 'home' ? '' : '/';
// The English page is one page, so its links are anchors on it.
const links = en
  ? [
      { href: '#services', label: 'Services' },
      { href: '#products', label: 'Products' },
    ]
  : [
      { href: `${home}#xizmatlar`, label: 'Xizmatlar' },
      { href: `${home}#ishlar`, label: 'Ishlar' },
      { href: `${home}#narxlar`, label: 'Narxlar' },
      { href: '/blog/', label: 'Blog', active: current === 'blog' },
    ];
const switchLang = en
  ? { href: '/', label: 'UZ', hreflang: 'uz', title: 'Oʻzbekcha' }
  : { href: '/en/', label: 'EN', hreflang: 'en', title: 'English' };
---
<header class="head">
  <nav aria-label={en ? 'Main menu' : 'Asosiy menyu'} class="wrap nav">
    <a href={en ? '/en/' : '/'} class="brand" aria-label={en ? 'Akbarov Labs — home' : 'Akbarov Labs — bosh sahifa'}>
      <Mark size={34} />
      <span>akbarov labs</span>
    </a>
    <div class="links">
      {links.map((l) => (
        <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
    <div class="actions">
      <div class="lang" role="group" aria-label={en ? 'Language' : 'Til'}>
        <span class="lang-on" aria-current="true">{en ? 'EN' : 'UZ'}</span>
        <a href={switchLang.href} hreflang={switchLang.hreflang} lang={switchLang.hreflang} title={switchLang.title}>{switchLang.label}</a>
      </div>
      <a href={en ? '#contact' : `${home}#aloqa`} class="btn btn-primary btn-sm">{en ? 'Contact' : 'Bogʻlanish'}</a>
    </div>
  </nav>
</header>

<style>
  .head {
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }
  .nav {
    padding-block: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 40px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--display);
    font-weight: 700;
    font-size: 18px;
    padding: 6px 0;
  }
  .brand:hover {
    color: var(--ink);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 32px;
    flex: 1 1 auto;
    font-size: 16px;
    font-weight: 500;
  }
  .links a {
    color: var(--ink);
    text-decoration: none;
    padding: 12px 0;
  }
  .links a:hover {
    color: var(--lapis);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .lang {
    display: flex;
    align-items: center;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    line-height: 1;
  }
  .lang > * {
    padding: 8px 11px;
    border-radius: 999px;
  }
  .lang-on {
    background: var(--ink);
    color: var(--white);
  }
  .lang a {
    color: var(--muted);
    text-decoration: none;
  }
  .lang a:hover {
    color: var(--lapis);
  }
  .links a[aria-current='page'] {
    color: var(--lapis);
    text-decoration: underline;
    text-decoration-color: var(--saffron);
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
  }
  @media (max-width: 760px) {
    .nav {
      justify-content: space-between;
      column-gap: 12px;
    }
    .brand {
      font-size: 16px;
    }
    .actions {
      gap: 8px;
    }
    /* No room for both halves on a phone: show only the language to switch to. */
    .lang-on {
      display: none;
    }
    .lang > * {
      padding: 8px 9px;
    }
    .links {
      order: 3;
      flex-basis: 100%;
      justify-content: space-between;
      gap: 0 12px;
      font-size: 15px;
    }
  }
</style>
