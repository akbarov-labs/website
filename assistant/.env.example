# Copy to assistant/.env for local runs (npm run dev, npm run eval). On the
# server the same names go in /opt/apps/akbarovlabs/.env.

# console.anthropic.com → API Keys. Secret.
ANTHROPIC_API_KEY=
# "true" turns the live chat on; anything else keeps the sample chat.
ASSISTANT_ENABLED=false
# claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5.
ASSISTANT_MODEL=claude-opus-5-5
# Past this many US dollars in a day (Tashkent time) the chat shows the contact button instead.
ASSISTANT_DAILY_BUDGET_USD=2

# Cloudflare → Turnstile. Leave empty locally: no check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The bot that sends leads, and the chat it sends them to (yours). Secret.
LEAD_BOT_TOKEN=
LEAD_CHAT_ID=
